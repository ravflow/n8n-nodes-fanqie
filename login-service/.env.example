PUBLIC_URL=https://fanqie-login.example.com
CLIENT_ID=fanqie-n8n
# Generate independent random secrets; never put real values in Git.
CLIENT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# 32 random bytes encoded as base64. Keep this key across restarts.
SESSION_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
REDIRECT_URIS=https://n8n.example.com/rest/oauth2-credential/callback
BIND_ADDRESS=127.0.0.1
ALLOW_INSECURE_HTTP=false
SESSION_TTL_HOURS=720
MAX_LOGIN_SESSIONS=2
