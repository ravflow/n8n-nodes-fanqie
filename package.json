{
	"name": "n8n-nodes-fanqie",
	"version": "0.1.1-alpha.7",
	"description": "Fanqie Novel author workspace integration for self-hosted n8n",
	"license": "MIT",
	"homepage": "https://github.com/ravflow/n8n-nodes-fanqie#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ravflow/n8n-nodes-fanqie.git"
	},
	"bugs": {
		"url": "https://github.com/ravflow/n8n-nodes-fanqie/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Tamseno",
		"email": "Ezratam.me@gmail.com"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test tests/*.test.cjs",
		"typecheck": "tsc --noEmit --incremental false",
		"test:login": "node --test login-service/tests/*.test.mjs",
		"format": "prettier --write nodes credentials tests scripts docs examples README.md package.json tsconfig.json",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"docs",
		"examples",
		"login-service"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FanqieAuthorApi.credentials.js",
			"dist/credentials/FanqieAuthorQrLoginOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/FanqieAuthor/FanqieAuthor.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.51.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"n8n-workflow": "2.16.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
